# Optional: live answer generation requires an API key. Saved replay does not.
OPENAI_API_KEY=
# false permits model downloads for live hybrid/reranked retrieval.
ADAPTIVE_RAG_LOCAL_FILES_ONLY=false
# For a standalone clone, point these at your private frozen outputs.
# By default, Docker Compose uses the sibling project's data and artifacts folders.
# ADAPTIVE_RAG_DATA_DIR=C:/path/to/data/processed/luna_v2
# ADAPTIVE_RAG_ARTIFACT_DIR=C:/path/to/artifacts/luna_v2
